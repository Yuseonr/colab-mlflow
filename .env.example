# This file is local-only. Copy it to .env and set your own Drive locations.
COLAB_MLFLOW_LOCAL_STORAGE_ROOT=/path/to/Google Drive/My Drive/colab-mlflow-storage
COLAB_MLFLOW_COLAB_STORAGE_ROOT=/content/drive/MyDrive/colab-mlflow-storage

# Local SQLite state. Keep it inside this colab-mlflow checkout and outside
# Google Drive. Replace /path/to/colab-mlflow with this tool's actual path.
COLAB_MLFLOW_LOCAL_STATE_ROOT=/path/to/colab-mlflow/.state

# Default worker identity and optional single-worker UI filter.
# Each concurrent Colab notebook sets its own WORKER_ID; all publish unique run IDs.
COLAB_MLFLOW_WORKER_ID=worker-a
